{
  "name": "dsh-task-supervisor",
  "version": "0.1.4",
  "description": "DSH-native supervised task lifecycle",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./check-gateway": "./lib/check-gateway.mjs",
    "./process-provenance": "./lib/process-provenance.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.mjs",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown",
    "test:kernel": "node spikes/kernel/run.mjs --reporter=verbose",
    "check:kernel": "node spikes/kernel/typecheck.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "tsdown": "0.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.8",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-alpha.2",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-attachment": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.7-alpha.2"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "packageManager": "pnpm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gosomea/dsh-task-supervisor.git"
  },
  "homepage": "https://github.com/gosomea/dsh-task-supervisor#readme",
  "bugs": {
    "url": "https://github.com/gosomea/dsh-task-supervisor/issues"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-attachment": "^0.1.7-alpha.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.1.7-alpha.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.7-alpha.2 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.1.7-alpha.2 || ^0.2.0-rc.2"
  }
}
